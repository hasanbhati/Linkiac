{
  "expo": {
    "name": "Linkiac",
    "slug": "linkiac",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linkiac.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "package": "com.linkiac.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "linkiac"
  }
}
