# Supabase Configuration
# Replace these values with your project credentials from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for admin server-side operations (DO NOT expose in client code)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
